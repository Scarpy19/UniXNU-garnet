diff --git a/package/UniXNUPkg/Library/UniXNULib/Main.c b/package/UniXNUPkg/Library/UniXNULib/Main.c
index c54a57a..fc8f3aa 100644
--- a/package/UniXNUPkg/Library/UniXNULib/Main.c
+++ b/package/UniXNUPkg/Library/UniXNULib/Main.c
@@ -44,6 +44,15 @@ UniXNULog (
     Size = AsciiStrLen (Line);
     mSerial->Write (mSerial, &Size, Line);
   }
+
+  // Temporary garnet bring-up mirror.  The device has no exposed UART or
+  // USB debug transport, so make UniXNU's log visible before the UI starts.
+  if (gST->ConOut != NULL) {
+    CHAR16  WideLine[256];
+    if (!EFI_ERROR (AsciiStrToUnicodeStrS (Line, WideLine, ARRAY_SIZE (WideLine)))) {
+      gST->ConOut->OutputString (gST->ConOut, WideLine);
+    }
+  }
 }
 
 EFI_STATUS
diff --git a/package/UniXNUPkg/UniXNUPkg.dec b/package/UniXNUPkg/UniXNUPkg.dec
