diff --git a/scripts/unixnu/bootimg.py b/scripts/unixnu/bootimg.py
index de568f8..2789ef9 100644
--- a/scripts/unixnu/bootimg.py
+++ b/scripts/unixnu/bootimg.py
@@ -48,7 +48,9 @@ def patch_dtb(dtb, nodes, scratch):
     work = scratch / 'device.dtb'
     work.write_bytes(dtb)
     for node in nodes:
-        run([fdtput, '-c', work, node['path']], capture=True)
+        # A firmware DTB normally already contains /chosen.  fdtput -c
+        # returns FDT_ERR_EXISTS for such nodes, even though its property
+        # writes are valid.  Only the properties need to be updated here.
         for prop in node.get('props', []):
             values = prop['value'] if isinstance(prop['value'], list) else [prop['value']]
             run([fdtput, '-t', prop.get('type', 's'), work, node['path'], prop['name'], *[str(v) for v in values]], capture=True)
