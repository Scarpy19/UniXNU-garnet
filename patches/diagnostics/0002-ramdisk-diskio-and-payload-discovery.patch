+//
+// The EDK II FAT driver does not bind to a Block I/O handle: FatDriverBindingSupported
+// opens EFI_DISK_IO_PROTOCOL (BY_DRIVER) and tests EFI_BLOCK_IO_PROTOCOL.  A handle that
+// publishes only Block I/O therefore never reaches SimpleFileSystem, which is why the
+// payload volume used to stay invisible to the configuration reader.  Publish a
+// byte-addressed Disk I/O view of the same read-only media.
+//
+STATIC
+EFI_STATUS
+EFIAPI
+RamDiskReadDisk (
+  IN  EFI_DISK_IO_PROTOCOL  *This,
+  IN  UINT32                MediaId,
+  IN  UINT64                Offset,
+  IN  UINTN                 BufferSize,
+  OUT VOID                  *Buffer
+  )
+{
+  UINT64  MediaSize;
+
+  if (MediaId != mMedia.MediaId) {
+    return EFI_MEDIA_CHANGED;
+  }
+
+  if (BufferSize == 0) {
+    return EFI_SUCCESS;
+  }
+
+  if (Buffer == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  MediaSize = MultU64x32 (mMedia.LastBlock + 1, mMedia.BlockSize);
+  if ((Offset > MediaSize) || ((UINT64)BufferSize > MediaSize - Offset)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  CopyMem (Buffer, mRamBase + Offset, BufferSize);
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+RamDiskWriteDisk (
+  IN EFI_DISK_IO_PROTOCOL  *This,
+  IN UINT32                MediaId,
+  IN UINT64                Offset,
+  IN UINTN                 BufferSize,
+  IN VOID                  *Buffer
+  )
+{
+  return EFI_WRITE_PROTECTED;
+}
+
+STATIC EFI_DISK_IO_PROTOCOL  mDiskIo = {
+  EFI_DISK_IO_PROTOCOL_REVISION,
+  RamDiskReadDisk,
+  RamDiskWriteDisk
+};
