+//
+// garnet does not tell us the ramdisk address in a way we can trust: the boot
+// image has header version 4 (no load address), the appended device tree is
+// ours, so /chosen may still carry the values we packed instead of the address
+// Android actually used.  Identify the payload by its FAT boot sector instead
+// of trusting a property.  The volume label is the one the payload builder
+// wrote (board.toml [payload] volume, "UNIXNU" by default).
+//
+#define UNIXNU_PAYLOAD_LABEL  "UNIXNU"
+
+STATIC
+UINT64
+PayloadVolumeBytes (
+  IN CONST UINT8  *Sector
+  )
+{
+  UINT32  TotalSectors;
+
+  TotalSectors = ReadUnaligned16 ((CONST UINT16 *)(Sector + 19));
+  if (TotalSectors == 0) {
+    TotalSectors = ReadUnaligned32 ((CONST UINT32 *)(Sector + 32));
+  }
+
+  return MultU64x32 (TotalSectors, 512);
+}
+
+STATIC
+BOOLEAN
+PayloadVolumeAt (
+  IN  UINT64  Start,
+  OUT UINT64  *VolumeBytes OPTIONAL
+  )
+{
+  CONST UINT8  *Sector;
+  UINT16       Signature;
+  UINT16       BytesPerSector;
+  UINT8        SectorsPerCluster;
+  UINT16       ReservedSectors;
+  UINT8        FatCount;
+  UINT64       Bytes;
+
+  if ((Start == 0) || ((Start & (RAM_BLOCK_SIZE - 1)) != 0)) {
+    return FALSE;
+  }
+
+  Sector    = (CONST UINT8 *)(UINTN)Start;
+  Signature = (UINT16)((Sector[510] << 8) | Sector[511]);
+
+  //
+  // A FAT boot sector: 0x55AA, 512-byte sectors, a power-of-two cluster, a
+  // non-zero reserved area, one to four FATs and a non-zero sector total.
+  // The label then confirms it is the UniXNU payload and not another volume.
+  //
+  BytesPerSector    = ReadUnaligned16 ((CONST UINT16 *)(Sector + 11));
+  SectorsPerCluster = Sector[13];
+  ReservedSectors   = ReadUnaligned16 ((CONST UINT16 *)(Sector + 14));
+  FatCount          = Sector[16];
+  Bytes             = PayloadVolumeBytes (Sector);
+
+  if ((Signature != 0xAA55) || (BytesPerSector != RAM_BLOCK_SIZE) ||
+      (SectorsPerCluster == 0) || ((SectorsPerCluster & (SectorsPerCluster - 1)) != 0) ||
+      (ReservedSectors == 0) || (FatCount == 0) || (FatCount > 4) || (Bytes == 0))
+  {
+    return FALSE;
+  }
+
+  if (AsciiStrnCmp ((CONST CHAR8 *)(Sector + 71), UNIXNU_PAYLOAD_LABEL, sizeof (UNIXNU_PAYLOAD_LABEL) - 1) != 0) {
+    return FALSE;
+  }
+
+  if (VolumeBytes != NULL) {
+    *VolumeBytes = Bytes;
+  }
+
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+FindPayloadVolume (
+  OUT UINT64  *Start,
+  OUT UINT64  *VolumeBytes
+  )
+{
+  EFI_STATUS             Status;
+  UINTN                  MapSize;
+  UINTN                  MapKey;
+  UINTN                  DescriptorSize;
+  UINT32                 DescriptorVersion;
+  EFI_MEMORY_DESCRIPTOR  *Map;
+  UINTN                  Count;
+  UINTN                  Index;
+  UINT64                 Address;
+
+  MapSize = 0;
+  Status  = gBS->GetMemoryMap (&MapSize, NULL, &MapKey, &DescriptorSize, &DescriptorVersion);
+  if (Status != EFI_BUFFER_TOO_SMALL) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: memory map size %r\n", Status));
+    return FALSE;
+  }
+
+  MapSize += 4 * DescriptorSize;
+  Map      = AllocatePool (MapSize);
+  if (Map == NULL) {
+    return FALSE;
+  }
+
+  Status = gBS->GetMemoryMap (&MapSize, Map, &MapKey, &DescriptorSize, &DescriptorVersion);
+  if (EFI_ERROR (Status)) {
+    FreePool (Map);
+    return FALSE;
+  }
+
+  Count = MapSize / DescriptorSize;
+  for (Index = 0; Index < Count; Index++) {
+    EFI_MEMORY_DESCRIPTOR  *Descriptor;
+
+    Descriptor = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Map + Index * DescriptorSize);
+
+    //
+    // Only ordinary DRAM is scanned.  The ramdisk buffer ABL fills is free
+    // memory, so it shows up as conventional, boot-services or loader data;
+    // MMIO, reserved firmware windows, unusable and PAL regions are skipped
+    // because reading them is not safe.
+    //
+    if ((Descriptor->Type != EfiConventionalMemory) &&
+        (Descriptor->Type != EfiBootServicesData) &&
+        (Descriptor->Type != EfiLoaderData))
+    {
+      continue;
+    }
+
+    for (Address = Descriptor->PhysicalStart;
+         Address + RAM_BLOCK_SIZE <= Descriptor->PhysicalStart + MultU64x32 (Descriptor->NumberOfPages, EFI_PAGE_SIZE);
+         Address += RAM_BLOCK_SIZE)
+    {
+      if (PayloadVolumeAt (Address, VolumeBytes)) {
+        *Start = Address;
+        FreePool (Map);
+        return TRUE;
+      }
+    }
+  }
+
+  FreePool (Map);
+  return FALSE;
+}
