 STATIC
 BOOLEAN
 TryVolume (
@@ -1501,13 +1547,37 @@ TryVolume (
   )
 {
   EFI_STATUS  Status;
+  EFI_FILE_PROTOCOL *FsRoot;
+  EFI_FILE_PROTOCOL *Directory;
   CHAR8       *Text;
   UINTN       Size;
   TOML_NODE   *Root;
   CHAR8       Error[96];
 
+  UniXNULog ("config: probing volume %p", Volume);
+  FsRoot = NULL;
+  Status = DebugOpenRoot (Volume, &FsRoot);
+  if (!EFI_ERROR (Status)) {
+    DumpDirectory (FsRoot, "root:");
+    Directory = NULL;
+    Status = FsRoot->Open (FsRoot, &Directory, L"\\EFI", EFI_FILE_MODE_READ, 0);
+    if (!EFI_ERROR (Status)) {
+      DumpDirectory (Directory, "EFI:");
+      Directory->Close (Directory);
+    }
+    FsRoot->Close (FsRoot);
+  }
   Status = UniXNUReadFile (Volume, (CONST CHAR16 *)PcdGetPtr (PcdUniXNUConfigPath), (VOID **)&Text, &Size);
   if (EFI_ERROR (Status)) {
+    UniXNULog ("config: canonical path unavailable (%r), trying FAT alias", Status);
+    // Some Qualcomm EDK2 FAT configurations expose the VFAT long-name
+    // entry only through its generated 8.3 alias.  Keep the canonical path
+    // first, then accept the alias produced for unixnu.toml by mtools.
+    UniXNULog ("config: canonical path unavailable (%r), trying FAT alias", Status);
+    Status = UniXNUReadFile (Volume, L"\\EFI\\UniXNU\\UNIXNU.TOM", (VOID **)&Text, &Size);
+  }
+  if (EFI_ERROR (Status)) {
+    UniXNULog ("config: FAT alias unavailable on %p (%r)", Volume, Status);
     return FALSE;
   }
 
