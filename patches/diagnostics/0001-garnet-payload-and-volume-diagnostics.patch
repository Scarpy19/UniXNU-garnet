       for (Index = 0; Index < Count && !Loaded && Config->Error[0] == '\0'; Index++) {
+        Status = gBS->ConnectController (Handles[Index], NULL, NULL, TRUE);
+        UniXNULog ("config: connect volume %p -> %r", Handles[Index], Status);
         Loaded = TryVolume (Config, Handles[Index]);
